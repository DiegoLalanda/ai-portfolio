---
import Layout from "@/layouts/Layout.astro";
import HeroIntro from "@/components/sections/HeroIntro.astro";
import AiPromptCapsules from "@/components/sections/AiPromptCapsules.astro";
import SubmittedPrompt from "@/components/sections/SubmittedPrompt.astro";
import LoadingPanel from "@/components/sections/LoadingPanel.astro";
import DashboardResults from "@/components/sections/DashboardResults.astro";
import ProjectDetailModal from "@/components/sections/ProjectDetailModal.astro";
import SiteFooter from "@/components/layout/SiteFooter.astro";

const loadingMessages = [
  "Analyzing your question...",
  "Searching Diego's experience...",
  "Mapping technical architecture...",
  "Finding relevant projects...",
  "Preparing visual dashboard...",
  "Calibrating system parameters...",
  "Synthesizing results...",
];
---

<Layout title="Diego - AI Engineer & Physics Professor">
  <div id="page-root" class="flex h-dvh flex-col overflow-hidden">
    <div class="pointer-events-none fixed inset-0 z-0 opacity-60">
      <canvas id="aurora-shader-canvas" class="block h-full w-full"></canvas>
    </div>
    <div id="aurora-particles-container" class="pointer-events-none fixed inset-0 z-0 opacity-40"></div>

    <main
      id="parallax-container"
      class="relative z-10 flex min-h-0 flex-1 flex-col items-center justify-center overflow-y-auto px-margin-edge pb-4 pt-6 md:pt-8"
    >
      <!-- Fase 1: landing (hero + sugerencias + input) -->
      <div id="phase-landing" class="flex w-full max-w-container-max flex-col items-center text-center">
        <HeroIntro tagline="Get to know me by asking anything." compact />
        <AiPromptCapsules />
      </div>

      <!-- Fase 2: procesando (hero atenuado + pregunta enviada + panel de carga) -->
      <div id="phase-processing" class="hidden flex w-full max-w-container-max flex-col items-center text-center">
        <HeroIntro receded />
        <SubmittedPrompt question="What is your AI experience?" />
        <LoadingPanel messages={loadingMessages} autostart={false} label="Architecting Insights" />
      </div>
    </main>

    <!-- Fase 3: dashboard (debajo del main, encima del footer) -->
    <section
      id="phase-dashboard"
      class="relative z-10 hidden shrink-0 translate-y-10 px-margin-edge py-section-gap-desktop opacity-0 transition-all duration-1000 ease-out"
    >
      <!-- Respuesta real del backend (todavía mockeada, sin Gemini conectado). -->
      <div id="ai-response-panel" class="mx-auto mb-gutter max-w-container-max glass-panel rounded-xl p-6 text-left">
        <div class="section-label mb-3">
          <span class="material-symbols-outlined text-[14px]">bolt</span>
          Backend Response
        </div>
        <p id="ai-response-text" class="font-body-md text-body-md text-on-surface-variant"></p>
      </div>

      <DashboardResults />
    </section>

    <SiteFooter compact class="z-10 shrink-0 transition-all duration-500" />
  </div>

  <!-- Modal de detalle de proyecto: se abre sobre landing/dashboard (ver DashboardResults) -->
  <ProjectDetailModal />
</Layout>

<script>
  import { initAuroraShader } from "@/lib/aurora-shader";
  import { initAuroraParticles } from "@/lib/aurora-particles";
  import { sendChatMessage } from "@/lib/api";

  const canvas = document.getElementById("aurora-shader-canvas");
  if (canvas instanceof HTMLCanvasElement) initAuroraShader(canvas);

  const particlesContainer = document.getElementById("aurora-particles-container");
  if (particlesContainer) initAuroraParticles(particlesContainer);

  document.addEventListener("mousemove", (event) => {
    const x = (event.clientX / window.innerWidth - 0.5) * 20;
    const y = (event.clientY / window.innerHeight - 0.5) * 20;
    const parallax = document.getElementById("parallax-container");
    if (parallax) {
      parallax.style.transform = `translate(${x}px, ${y}px)`;
    }
  });

  const pageRoot = document.getElementById("page-root");
  const main = document.getElementById("parallax-container");
  const landingPhase = document.getElementById("phase-landing");
  const processingPhase = document.getElementById("phase-processing");
  const dashboardPhase = document.getElementById("phase-dashboard");
  const responseText = document.getElementById("ai-response-text");

  // El paso a la fase 3 (dashboard) requiere que termine tanto la animación de
  // "Thinking" (loading:complete) como la respuesta real del backend.
  let loadingAnimationDone = false;
  let backendAnswer: string | null = null;

  function revealDashboard() {
    if (!dashboardPhase || !pageRoot || !main) return;

    if (responseText) responseText.textContent = backendAnswer ?? "";

    // Dejar de fijar el alto al viewport: el documento crece con main + dashboard + footer.
    pageRoot.classList.remove("h-dvh", "overflow-hidden");
    pageRoot.classList.add("min-h-dvh");

    main.classList.remove("flex-1", "min-h-0", "overflow-y-auto", "justify-center");
    main.classList.add("shrink-0");

    dashboardPhase.classList.remove("hidden");
    requestAnimationFrame(() => {
      dashboardPhase.classList.remove("opacity-0", "translate-y-10");
      dashboardPhase.scrollIntoView({ behavior: "smooth", block: "start" });
    });
  }

  function maybeRevealDashboard() {
    if (loadingAnimationDone && backendAnswer !== null) revealDashboard();
  }

  window.addEventListener("mock-chat:submit", (event) => {
    if (!landingPhase || !processingPhase) return;

    const question = (event as CustomEvent<{ question: string }>).detail?.question ?? "";
    const submittedQuestion = document.getElementById("submitted-question") as HTMLInputElement | null;
    if (submittedQuestion) submittedQuestion.value = question;

    loadingAnimationDone = false;
    backendAnswer = null;

    landingPhase.classList.add("hidden");
    processingPhase.classList.remove("hidden");
    main?.classList.remove("justify-center");
    main?.classList.add("justify-start");
    window.dispatchEvent(new CustomEvent("loading:start"));

    // Llamada real al backend (POST /api/v1/chat). Todavía mockeada del lado
    // del servidor: sin Gemini conectado, solo se verifica el round-trip.
    sendChatMessage(question)
      .then((data) => {
        backendAnswer = data.answer;
        maybeRevealDashboard();
      })
      .catch((error) => {
        console.error("Error al llamar al backend:", error);
        backendAnswer = "Couldn't reach the backend right now. Please make sure the API is running.";
        maybeRevealDashboard();
      });
  });

  window.addEventListener("loading:complete", () => {
    loadingAnimationDone = true;
    maybeRevealDashboard();
  });
</script>
