---
/** Filtros SVG para distorsión líquida en texto (misma familia que el shader aurora). */
---

<svg aria-hidden="true" class="pointer-events-none absolute h-0 w-0 overflow-hidden" focusable="false">
  <defs>
    <filter id="text-liquid-warp" x="-25%" y="-25%" width="150%" height="150%" color-interpolation-filters="sRGB">
      <feTurbulence id="text-liquid-turbulence" type="fractalNoise" baseFrequency="0.014 0.018" numOctaves="2" seed="4" result="noise" />
      <feDisplacementMap id="text-liquid-displacement" in="SourceGraphic" in2="noise" scale="0" xChannelSelector="R" yChannelSelector="G" />
    </filter>
  </defs>
</svg>
