const roadmap = [
  {
    quarter: "Q1 Concept",
    title: "Theoretical Base",
    description: "Core synchronization math and protocol design.",
    dotColorClass: "bg-primary",
    labelColorClass: "text-primary",
  },
  {
    quarter: "Q2 Alpha",
    title: "Rust Prototype",
    description: "First working implementation of the gossip protocol.",
    dotColorClass: "bg-secondary",
    labelColorClass: "text-secondary",
  },
  {
    quarter: "Q3 Beta",
    title: "Edge Scaling",
    description: "Stress testing with 10k simulated virtual nodes.",
    dotColorClass: "bg-tertiary",
    labelColorClass: "text-tertiary",
  },
  {
    quarter: "Q4 Launch",
    title: "V1.0 Deploy",
    description: "Production release and integration documentation.",
