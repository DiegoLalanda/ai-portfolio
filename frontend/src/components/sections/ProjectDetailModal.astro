const visualizations = [
  {
    title: "Latency Monitor",
    description: "Real-time edge performance tracking.",
    image:
      "https://lh3.googleusercontent.com/aida-public/AB6AXuCyKLqkwNuxQEXe43lSCnFC1sdr2t3zsRR_3j-wLVV0HMJ61wHWo1Gbwk-WhEk-4OakdgyWikqGJBVFZy0rc79YfB_2MTcpyTOlYsvtd1kZqsEhYbu24_Pu_KuoYCBZn2JNiVyGzFstKqBYdNhCx65gGSwgGNRJ2bftjXok7OpppRGNhHf2DlgO3b0MOGW_IsD8gsSq7zhwYx1eOCuW6fXJduIqpexD77V44UGEGe2UDy7yeUOjtqA0ukg9dAAnSThKfjkWAuGJLj8M",
    hoverColorClass: "hover:border-primary/50",
  },
  {
    title: "Topology View",
    description: "Dynamic node connection mapping.",
    image:
      "https://lh3.googleusercontent.com/aida-public/AB6AXuC_USvb2rZAyFCJpjcyRs0pE6RsXl__TokeS-1dz1v5obdEJYCqN3s8gOZotAeqviB3gHHCOg-EhFpOzQL5VLQTAyGCutT0JYukz-OirJXfSzF0KoB0lOmi2L14MRfoNoVh3baDuqDxr0SH6lAsF-llwfqa372fx-x01_IqyOakwvztZbjeBEKyB5NklHVLinzqezxOtzMBg3cCbGc6AkXXD4_TGiIi-DvWpLH1jCRKwoOk6zneB45DvyCpfns_HuKKhqAlbRRD58AS",
    hoverColorClass: "hover:border-secondary/50",
  },
  {
    title: "Deployment CLI",
    description: "Automated orchestration toolset.",
    image:
      "https://lh3.googleusercontent.com/aida-public/AB6AXuCjee4O2UUkrxfukSQTysTmHOjKLeQHZsTC3k8zLY5dBlBXp7OsGzl1ojzUZmr2yOLXNVCHldB8gXynWgLtBMBYQJi96M6TQU-MCJgr4TamDj5G0WSk1wFEdJBc-ukJgtW96krFobyaOTBTWsrLZxCedlwvVemwQ6TKHfqd98mJsn1lq0e5uJ7qAHR8hAFztkMYqknti6A-QXzhItHSmwEEmWVOB9HqB6dnlm_SDTxtuVZ06W1FngQQqm4s3Ave92Tkn2sTKRFGDXpw",
    hoverColorClass: "hover:border-tertiary/50",
  },
