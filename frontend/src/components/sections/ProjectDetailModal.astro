---
/**
 * Modal de detalle de proyecto: se abre sobre la landing/dashboard al recibir
 * el evento `project-detail:open` (disparado desde la case study card del
 * dashboard). Solo hay un proyecto mockeado ("NeuralSync Architecture") hasta
 * integrar datos reales por proyecto.
 */

const tags = ["Rust", "CUDA", "WebGPU"];

const architectureNodes = [
  {
    icon: "hub",
    title: "Central Hub",
    subtitle: "Rust Engine",
    position: "top-[20%] left-[32%]",
    colorClass: "border-primary/40 bg-primary/10 text-primary",
    pulse: true,
  },
  {
    icon: "cloud_done",
    title: "Edge Node A",
    subtitle: "In-Transit",
    position: "top-[47%] left-[15%]",
    colorClass: "border-secondary/40 bg-secondary/10 text-secondary",
  },
  {
    icon: "memory",
    title: "GPU Cluster",
    subtitle: "WebGPU Kernels",
    position: "top-[72%] left-[48%]",
    colorClass: "border-tertiary/40 bg-tertiary/10 text-tertiary",
  },
  {
    icon: "monitor_heart",
    title: "Observer",
    subtitle: "Telemetry",
    position: "top-[47%] left-[82%]",
    colorClass: "border-on-surface-variant/40 bg-surface-container text-on-surface-variant",
  },
