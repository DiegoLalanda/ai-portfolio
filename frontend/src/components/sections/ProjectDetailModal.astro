---

<div
  id="project-detail-modal"
  role="dialog"
  aria-modal="true"
  aria-label="NeuralSync Architecture project detail"
  aria-hidden="true"
  class="fixed inset-0 z-50 hidden flex-col overflow-y-auto bg-background/90 opacity-0 backdrop-blur-xl transition-opacity duration-500"
>
  <div class="sticky top-0 z-10 flex justify-end px-margin-edge py-6">
    <button
      type="button"
      id="close-project-detail"
      aria-label="Close project detail"
      class="secondary-btn flex h-11 w-11 items-center justify-center rounded-full text-on-surface"
    >
      <span class="material-symbols-outlined" aria-hidden="true">close</span>
    </button>
  </div>

  <main class="mx-auto w-full max-w-container-max px-margin-edge pb-section-gap-desktop pt-0">
    <section class="mb-section-gap-desktop flex flex-col items-center text-center fade-in-up">
      <div class="mb-6 flex gap-3">
        {
          tags.map((tag) => (
            <span class="rounded-full border border-primary/30 bg-primary/10 px-4 py-1.5 font-label-sm text-[10px] uppercase tracking-wider text-primary">
              {tag}
            </span>
          ))
        }
      </div>
      <h1 class="font-display-xl text-display-xl mb-6 max-w-4xl text-white">NeuralSync Architecture</h1>
      <p class="font-body-lg text-body-lg mb-10 max-w-2xl text-on-surface-variant">
        A high-concurrency neural orchestration layer designed for real-time synchronization between edge devices and
        centralized GPU clusters.
      </p>
      <div class="flex flex-wrap justify-center gap-4">
        <button type="button" class="primary-btn flex items-center gap-2 rounded-xl px-8 py-4 font-label-md text-white">
          <span class="material-symbols-outlined text-[20px]" aria-hidden="true">play_circle</span>
          Live Demo
        </button>
        <button type="button" class="secondary-btn flex items-center gap-2 rounded-xl px-8 py-4 font-label-md text-on-surface">
          <span class="material-symbols-outlined text-[20px]" aria-hidden="true">terminal</span>
          View on GitHub
        </button>
      </div>
    </section>

    <section class="mb-section-gap-desktop grid grid-cols-1 gap-6 fade-in-up md:grid-cols-12">
      <div class="mb-8 md:col-span-12">
        <h2 class="font-headline-lg text-headline-lg text-white">Strategic Insights</h2>
      </div>

      <div class="glass-card flex flex-col justify-between p-10 md:col-span-7">
        <div>
          <div class="mb-4 flex items-center gap-2 text-secondary">
            <span class="material-symbols-outlined" aria-hidden="true">psychology</span>
            <span class="font-label-md">The Challenge</span>
          </div>
          <p class="font-headline-md text-headline-md leading-snug text-white">
            Managing state synchronization across 10,000+ edge nodes with sub-20ms latency while maintaining strict
            data consistency.
          </p>
        </div>
        <p class="font-body-md mt-8 text-on-surface-variant">
          Traditional REST architectures failed at scale. We needed a binary-first protocol that minimized overhead
          and maximized throughput.
        </p>
      </div>

      <div class="glass-card bg-gradient-to-br from-primary/10 to-transparent p-10 md:col-span-5">
        <div class="mb-4 flex items-center gap-2 text-primary">
          <span class="material-symbols-outlined" aria-hidden="true">rocket_launch</span>
          <span class="font-label-md">The Results</span>
        </div>
        <div class="mb-2 text-[64px] font-bold leading-none text-white">45%</div>
        <div class="font-body-lg mb-4 text-white">Efficiency Gain</div>
        <p class="font-body-md text-on-surface-variant">
          Reduced total computational overhead by nearly half compared to previous Python-based orchestration
          layers.
        </p>
      </div>

      <div class="glass-card p-8 md:col-span-4">
        <div class="mb-4 flex items-center gap-2 text-tertiary">
          <span class="material-symbols-outlined" aria-hidden="true">lightbulb</span>
          <span class="font-label-md">Solution</span>
        </div>
        <p class="font-body-md text-on-surface-variant">
          Implemented a custom Rust-based gossip protocol with lock-free data structures for maximum performance.
        </p>
      </div>

      <div class="glass-card flex items-center gap-8 p-8 md:col-span-8">
        <div class="flex aspect-square w-1/3 items-center justify-center overflow-hidden rounded-xl border border-white/5 bg-surface-container-high">
          <span class="material-symbols-outlined text-[64px] text-outline-variant" aria-hidden="true">analytics</span>
        </div>
        <div class="flex-1">
          <div class="mb-4 flex items-center gap-2 text-outline">
            <span class="material-symbols-outlined" aria-hidden="true">auto_stories</span>
            <span class="font-label-md">Lessons Learned</span>
          </div>
          <p class="font-body-md text-on-surface-variant">
            Premature optimization is indeed the root of all evil, but at our scale, architectural choices had to be
            performance-first from day one.
          </p>
        </div>
      </div>
    </section>

    <section class="mb-section-gap-desktop fade-in-up">
      <div class="mb-12 flex flex-col items-end justify-between gap-6 md:flex-row">
        <div>
          <h2 class="font-headline-lg text-headline-lg mb-2 text-white">Architecture Blueprint</h2>
          <p class="font-body-md text-on-surface-variant">Low-level system topology and data flow visualization.</p>
        </div>
        <button type="button" class="secondary-btn flex items-center gap-2 rounded-full px-6 py-3 font-label-md text-on-surface">
          <span class="material-symbols-outlined" aria-hidden="true">fullscreen</span>
          Expand Blueprint
        </button>
      </div>
      <div class="glass-card group relative min-h-[600px] overflow-hidden node-diagram p-12">
        <svg class="pointer-events-none absolute inset-0 h-full w-full opacity-20 transition-opacity duration-700 group-hover:opacity-40">
          <path d="M 200,300 L 400,150 L 800,150 L 1000,300" fill="none" stroke="#d0bcff" stroke-width="2"></path>
          <path d="M 400,150 L 600,450 L 1000,300" fill="none" stroke="#4cd7f6" stroke-width="2"></path>
          <path d="M 200,300 L 600,450 L 800,150" fill="none" stroke="#ffb869" stroke-width="2"></path>
        </svg>
        {
          architectureNodes.map((node) => (
            <div
              class:list={[
                "glass-card absolute flex items-center gap-3 px-6 py-4",
                node.position,
                node.colorClass,
                { "animate-pulse": node.pulse },
              ]}
            >
              <span class="material-symbols-outlined" aria-hidden="true">{node.icon}</span>
              <div>
                <div class="font-label-md text-white">{node.title}</div>
                <div class="text-[10px] uppercase opacity-80">{node.subtitle}</div>
              </div>
            </div>
          ))
        }
        <div class="absolute bottom-8 right-8 flex items-center gap-2 text-outline-variant">
          <span class="material-symbols-outlined text-[16px]" aria-hidden="true">info</span>
          <span class="font-label-sm">Interactive Diagram — Hover to Inspect Nodes</span>
        </div>
      </div>
    </section>

    <section class="mb-section-gap-desktop fade-in-up">
      <h2 class="font-headline-lg text-headline-lg mb-12 text-center text-white">System Visualization</h2>
      <div class="grid grid-cols-1 gap-8 md:grid-cols-3">
        {
          visualizations.map((item) => (
            <div
              class:list={[
                "group relative cursor-pointer overflow-hidden rounded-3xl border border-white/10 transition-all",
                item.hoverColorClass,
              ]}
            >
              <img
                src={item.image}
                alt={`${item.title}: ${item.description}`}
                loading="lazy"
                decoding="async"
                class="aspect-video w-full object-cover transition-transform duration-700 group-hover:scale-110"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-[#050505] via-transparent to-transparent opacity-60" />
              <div class="absolute bottom-0 left-0 w-full translate-y-2 p-6 transition-transform group-hover:translate-y-0">
                <div class="font-headline-md mb-1 text-white">{item.title}</div>
                <p class="font-body-md text-sm text-on-surface-variant">{item.description}</p>
              </div>
            </div>
          ))
        }
      </div>
    </section>

    <section class="mb-section-gap-desktop fade-in-up">
      <h2 class="font-headline-lg text-headline-lg mb-16 text-center text-white">Project Roadmap</h2>
      <div class="glass-card relative px-8 py-20">
        <div class="roadmap-line absolute left-0 top-1/2 w-full -translate-y-1/2"></div>
        <div class="relative z-10 grid grid-cols-1 gap-12 md:grid-cols-4">
          {
            roadmap.map((step) => (
              <div class="group flex flex-col items-center">
                <div
                  class:list={[
                    "mb-6 h-4 w-4 rounded-full border-4 border-[#050505] transition-transform group-hover:scale-150",
                    step.dotColorClass,
                  ]}
                />
                <div class="text-center">
                  <div class:list={["font-label-md mb-2", step.labelColorClass]}>{step.quarter}</div>
                  <h3 class="font-headline-md mb-2 text-[18px] text-white">{step.title}</h3>
                  <p class="font-body-md text-sm text-on-surface-variant">{step.description}</p>
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <section class="flex justify-center fade-in-up">
      <button
        type="button"
        id="return-to-dashboard"
        class="flex items-center gap-3 rounded-full border border-white/10 bg-white/5 px-10 py-4 font-label-md text-primary shadow-[0_0_15px_rgba(208,188,255,0.1)] transition-all duration-300 hover:bg-primary hover:text-on-primary"
      >
        <span class="material-symbols-outlined" aria-hidden="true">arrow_back</span>
        Return to Portfolio
      </button>
    </section>
  </main>
</div>

<script>
  const modal = document.getElementById("project-detail-modal");
  const closeButton = document.getElementById("close-project-detail");
  const returnButton = document.getElementById("return-to-dashboard");
  const scrollableArea = modal?.querySelector("main");
  let previousFocus: HTMLElement | null = null;

  function getFocusableElements(): HTMLElement[] {
    if (!modal) return [];
    return Array.from(
      modal.querySelectorAll<HTMLElement>(
        'button, [href], input, select, textarea, [tabindex]:not([tabindex="-1"])'
      )
    ).filter((element) => !element.hasAttribute("disabled") && element.offsetParent !== null);
  }

  function openModal() {
    if (!modal) return;
    previousFocus = document.activeElement instanceof HTMLElement ? document.activeElement : null;
    document.body.style.overflow = "hidden";
    modal.classList.remove("hidden");
    modal.setAttribute("aria-hidden", "false");
    if (scrollableArea) scrollableArea.scrollTop = 0;
    requestAnimationFrame(() => {
      modal.classList.remove("opacity-0");
      modal.classList.add("modal-open");
    });
    closeButton?.focus();
  }

  function closeModal() {
    if (!modal) return;
    modal.classList.add("opacity-0");
    modal.classList.remove("modal-open");
    modal.setAttribute("aria-hidden", "true");
    document.body.style.overflow = "";
    window.setTimeout(() => {
      modal.classList.add("hidden");
      previousFocus?.focus();
    }, 500);
  }

  window.addEventListener("project-detail:open", openModal);
  closeButton?.addEventListener("click", closeModal);
  returnButton?.addEventListener("click", closeModal);

  modal?.addEventListener("keydown", (event) => {
    if (event.key !== "Tab" || modal.classList.contains("hidden")) return;

    const focusable = getFocusableElements();
    if (focusable.length === 0) return;

    const first = focusable[0];
    const last = focusable[focusable.length - 1];

    if (event.shiftKey && document.activeElement === first) {
      event.preventDefault();
      last.focus();
    } else if (!event.shiftKey && document.activeElement === last) {
      event.preventDefault();
      first.focus();
    }
  });

  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape" && modal && !modal.classList.contains("hidden")) closeModal();
  });
</script>
