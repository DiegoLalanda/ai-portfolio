---
interface Props {
  /** `editable`: input activo + botón enviar. `readonly`: pregunta enviada + indicador de check. */
  mode?: "editable" | "readonly";
  /** En readonly: permite editar al tocar y mostrar enviar solo si se modifica el texto. */
  reeditable?: boolean;
  inputId: string;
  value?: string;
  placeholder?: string;
  placeholders?: string[];
  sendAriaLabel?: string;
  resetAriaLabel?: string;
  class?: string;
}

const {
  mode = "editable",
  reeditable = false,
  inputId,
  value = "",
  placeholder,
  placeholders = [],
  sendAriaLabel = "Send",
  resetAriaLabel = "Ask again",
  class: className,
} = Astro.props;
const placeholderCycle = placeholders.length > 0 ? placeholders : ["..."];
const initialPlaceholder = placeholder ?? placeholderCycle[0];
const isReadonly = mode === "readonly";
---

<div
  class:list={["glass-input-container z-10 flex w-full items-center rounded-full px-6 py-2 md:py-4", className]}
  data-reeditable={reeditable ? "true" : undefined}
>
  <span
    class="material-symbols-outlined mr-4 text-primary"
    aria-hidden="true"
    style="font-variation-settings: 'FILL' 1;"
  >
    auto_awesome
  </span>
  <input
    id={inputId}
    type="text"
    autocomplete="off"
    readonly={isReadonly || undefined}
    value={isReadonly ? value : undefined}
    placeholder={!isReadonly ? initialPlaceholder : undefined}
    data-placeholder-cycle={!isReadonly ? JSON.stringify(placeholderCycle) : undefined}
    class="min-w-0 w-full border-none bg-transparent font-body-md text-body-md text-on-surface placeholder-outline-variant focus:outline-none focus:ring-0 read-only:truncate"
  />
  {
    isReadonly ? (
      <>
        <div
          data-prompt-status
          class="prompt-pill-status ml-4 flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-primary text-on-primary transition-all duration-300"
        >
          <span class="material-symbols-outlined text-[20px] leading-none" aria-hidden="true" style="font-variation-settings: 'FILL' 1;">
            check
          </span>
        </div>
        {
          reeditable && (
            <button
              type="button"
              id={`${inputId}-submit`}
              data-prompt-submit
              disabled
              aria-label={sendAriaLabel}
              class="scale-0 w-0 opacity-0 pointer-events-none ml-0 overflow-hidden flex h-10 shrink-0 items-center justify-center rounded-full bg-surface-container-high text-on-surface-variant transition-all duration-300 origin-center disabled:pointer-events-none disabled:opacity-40 enabled:bg-white enabled:text-black enabled:opacity-100 enabled:shadow-lg hover:enabled:scale-105 active:enabled:scale-95"
            >
              <span class="material-symbols-outlined" aria-hidden="true" style="font-variation-settings: 'FILL' 0;">
                arrow_forward
              </span>
            </button>
          )
        }
      </>
    ) : (
      <button
        type="button"
        id="voice-input-btn"
        class="hidden flex h-10 shrink-0 items-center justify-center rounded-full text-on-surface-variant hover:text-primary hover:bg-surface-container-high/40 transition-all duration-300 origin-center"
        aria-label="Start voice input"
      >
        <span class="material-symbols-outlined" aria-hidden="true" style="font-variation-settings: 'FILL' 0;">
          mic
        </span>
      </button>
      <button
        type="button"
        id="ai-input-submit"
        disabled
        aria-label={sendAriaLabel}
        class="scale-0 w-0 opacity-0 pointer-events-none ml-0 overflow-hidden flex h-10 shrink-0 items-center justify-center rounded-full bg-surface-container-high text-on-surface-variant transition-all duration-300 origin-center disabled:pointer-events-none disabled:opacity-40 enabled:bg-white enabled:text-black enabled:opacity-100 enabled:shadow-lg hover:enabled:scale-105 active:enabled:scale-95"
      >
        <span class="material-symbols-outlined" aria-hidden="true" style="font-variation-settings: 'FILL' 0;">
          arrow_forward
        </span>
      </button>
    )
  }
</div>

{
  !isReadonly && (
    <script>
      function prefersReducedMotion() {
        return window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      }

      function initPlaceholderCycle(input: HTMLInputElement) {
        const raw = input.dataset.placeholderCycle;
        if (!raw) return;

        const phrases: string[] = JSON.parse(raw);
        if (phrases.length === 0) return;

        let phraseIndex = 0;
        let charIndex = 0;
        let deleting = false;
        let stopped = false;
        let timeoutId: number | undefined;

        function clearTimer() {
          if (timeoutId !== undefined) window.clearTimeout(timeoutId);
        }

        function stopCycle() {
          stopped = true;
          clearTimer();
        }

        function tick() {
          if (stopped || document.activeElement === input || input.value.trim()) return;

          const phrase = phrases[phraseIndex] ?? "";

          if (!deleting) {
            charIndex += 1;
            input.placeholder = phrase.slice(0, charIndex);

            if (charIndex >= phrase.length) {
              deleting = true;
              timeoutId = window.setTimeout(tick, 1800);
              return;
            }

            timeoutId = window.setTimeout(tick, 45 + Math.random() * 25);
            return;
          }

          charIndex -= 1;
          input.placeholder = phrase.slice(0, charIndex);

          if (charIndex <= 0) {
            deleting = false;
            phraseIndex = (phraseIndex + 1) % phrases.length;
            timeoutId = window.setTimeout(tick, 350);
            return;
          }

          timeoutId = window.setTimeout(tick, 28);
        }

        input.addEventListener("focus", stopCycle);
        input.addEventListener("input", stopCycle);

        if (prefersReducedMotion()) {
          input.placeholder = phrases[0] ?? input.placeholder;
          return;
        }

        timeoutId = window.setTimeout(tick, 900);
      }

      function initVoiceInput(input: HTMLInputElement) {
        const voiceBtn = document.getElementById("voice-input-btn") as HTMLButtonElement | null;
        if (!voiceBtn) return;

        const SpeechRecognition = (window as any).SpeechRecognition || (window as any).webkitSpeechRecognition;
        if (!SpeechRecognition) return;

        voiceBtn.classList.remove("hidden");
        // Inicializar clases de visibilidad
        if (!input.value.trim()) {
          voiceBtn.classList.add("scale-100", "w-10", "opacity-100", "ml-2");
        } else {
          voiceBtn.classList.add("scale-0", "w-0", "opacity-0", "pointer-events-none", "ml-0", "overflow-hidden");
        }

        const recognition = new SpeechRecognition();
        recognition.continuous = false;
        
        const pageRoot = document.getElementById("page-root");
        const locale = pageRoot?.dataset.locale || "es";
        recognition.lang = locale === "en" ? "en-US" : "es-ES";
        
        recognition.interimResults = false;
        recognition.maxAlternatives = 1;

        let isRecording = false;
        let originalPlaceholder = "";

        function start() {
          try {
            recognition.start();
          } catch (e) {
            console.error("Error starting recognition", e);
          }
        }

        function stop() {
          try {
            recognition.stop();
          } catch (e) {
            console.error("Error stopping recognition", e);
          }
        }

        voiceBtn.addEventListener("click", () => {
          if (isRecording) {
            stop();
          } else {
            start();
          }
        });

        recognition.onstart = () => {
          isRecording = true;
          voiceBtn.classList.add("bg-red-500", "text-white", "animate-pulse");
          voiceBtn.classList.remove("text-on-surface-variant", "hover:text-primary", "hover:bg-surface-container-high/40");
          const iconSpan = voiceBtn.querySelector(".material-symbols-outlined");
          if (iconSpan) iconSpan.textContent = "mic_off";
          
          originalPlaceholder = input.placeholder;
          input.placeholder = locale === "en" ? "Listening..." : "Escuchando...";
          input.focus();
        };

        recognition.onresult = (event: any) => {
          const transcript = event.results[0]?.[0]?.transcript;
          if (transcript) {
            input.value = transcript;
            input.dispatchEvent(new Event("input", { bubbles: true }));
          }
        };

        recognition.onerror = (event: any) => {
          console.error("Speech recognition error", event.error);
          cleanup();
        };

        recognition.onend = () => {
          cleanup();
        };

        function cleanup() {
          isRecording = false;
          if (voiceBtn) {
            voiceBtn.classList.remove("bg-red-500", "text-white", "animate-pulse");
            voiceBtn.classList.add("text-on-surface-variant", "hover:text-primary", "hover:bg-surface-container-high/40");
            const iconSpan = voiceBtn.querySelector(".material-symbols-outlined");
            if (iconSpan) iconSpan.textContent = "mic";
          }
          
          if (originalPlaceholder) {
            input.placeholder = originalPlaceholder;
          }
        }
      }

      function updateButtonStates(input: HTMLInputElement) {
        const container = input.closest(".glass-input-container");
        if (!container) return;

        const voiceBtn = container.querySelector("#voice-input-btn") as HTMLButtonElement | null;
        const submitBtn = container.querySelector("#ai-input-submit") as HTMLButtonElement | null;
        if (!submitBtn) return;

        const hasText = !!input.value.trim();
        const SpeechRecognition = (window as any).SpeechRecognition || (window as any).webkitSpeechRecognition;
        const isVoiceSupported = !!SpeechRecognition;

        if (hasText) {
          // Mostrar botón de enviar
          submitBtn.classList.remove("scale-0", "w-0", "opacity-0", "pointer-events-none", "ml-0", "overflow-hidden");
          submitBtn.classList.add("scale-100", "w-10", "opacity-100", "ml-2");
          submitBtn.disabled = false;

          // Ocultar botón de voz si está soportado
          if (voiceBtn && isVoiceSupported) {
            voiceBtn.classList.remove("scale-100", "w-10", "opacity-100", "ml-2");
            voiceBtn.classList.add("scale-0", "w-0", "opacity-0", "pointer-events-none", "ml-0", "overflow-hidden");
          }
        } else {
          // Ocultar botón de enviar
          submitBtn.classList.remove("scale-100", "w-10", "opacity-100", "ml-2");
          submitBtn.classList.add("scale-0", "w-0", "opacity-0", "pointer-events-none", "ml-0", "overflow-hidden");
          submitBtn.disabled = true;

          // Mostrar botón de voz si está soportado
          if (voiceBtn && isVoiceSupported) {
            voiceBtn.classList.remove("scale-0", "w-0", "opacity-0", "pointer-events-none", "ml-0", "overflow-hidden");
            voiceBtn.classList.add("scale-100", "w-10", "opacity-100", "ml-2");
          }
        }
      }

      document.querySelectorAll<HTMLInputElement>("[data-placeholder-cycle]").forEach((input) => {
        initPlaceholderCycle(input);
        initVoiceInput(input);
        updateButtonStates(input);
        
        input.addEventListener("input", () => {
          updateButtonStates(input);
        });
      });
    </script>
  )
}

{
  isReadonly && reeditable && (
    <script>
      function setActionVisible(el: HTMLElement | null, visible: boolean, marginClass: string) {
        if (!el) return;
        if (visible) {
          el.classList.remove(
            "scale-0",
            "w-0",
            "opacity-0",
            "pointer-events-none",
            "ml-0",
            "overflow-hidden",
            "hidden",
          );
          el.classList.add("scale-100", "w-10", "opacity-100", marginClass);
        } else {
          el.classList.remove("scale-100", "w-10", "opacity-100", marginClass);
          el.classList.add(
            "scale-0",
            "w-0",
            "opacity-0",
            "pointer-events-none",
            "ml-0",
            "overflow-hidden",
          );
        }
      }

      function initReeditablePill(container: HTMLElement) {
        const input = container.querySelector("input") as HTMLInputElement | null;
        const status = container.querySelector("[data-prompt-status]") as HTMLElement | null;
        const submitBtn = container.querySelector("[data-prompt-submit]") as HTMLButtonElement | null;
        if (!input || !status || !submitBtn) return;

        let baseline = input.value;

        function showCommitted() {
          input!.setAttribute("readonly", "");
          status!.classList.remove("hidden");
          setActionVisible(status, true, "ml-4");
          setActionVisible(submitBtn, false, "ml-4");
          submitBtn!.disabled = true;
        }

        function showSend() {
          status!.classList.add("hidden");
          setActionVisible(status, false, "ml-4");
          setActionVisible(submitBtn, true, "ml-4");
          submitBtn!.disabled = !input!.value.trim();
        }

        function unlock() {
          if (container.dataset.reeditEnabled !== "true") return;
          input!.removeAttribute("readonly");
        }

        function syncFromEdit() {
          if (container.dataset.reeditEnabled !== "true") return;
          unlock();
          const dirty = input!.value.trim() !== baseline.trim();
          if (dirty && input!.value.trim()) {
            showSend();
          } else {
            showCommitted();
            // Seguir editable mientras reedit está activo, pero con check.
            input!.removeAttribute("readonly");
          }
        }

        input.addEventListener("pointerdown", unlock);
        input.addEventListener("focus", unlock);
        input.addEventListener("input", syncFromEdit);
        input.addEventListener("keydown", (event) => {
          if (event.key === "Enter" && !submitBtn.disabled) {
            submitBtn.click();
          }
        });

        submitBtn.addEventListener("click", () => {
          const question = input.value.trim();
          if (!question) return;
          window.dispatchEvent(new CustomEvent("mock-chat:submit", { detail: { question } }));
        });

        window.addEventListener("prompt:enable-reedit", () => {
          container.dataset.reeditEnabled = "true";
          baseline = input.value;
          showCommitted();
          // Listo para tocar y editar; el check se mantiene hasta que cambie el texto.
        });

        window.addEventListener("prompt:lock-reedit", () => {
          container.dataset.reeditEnabled = "false";
          baseline = input.value;
          showCommitted();
        });

        window.addEventListener("mock-chat:submit", ((event: CustomEvent<{ question: string }>) => {
          const question = event.detail?.question ?? input.value;
          container.dataset.reeditEnabled = "false";
          input.value = question;
          baseline = question;
          showCommitted();
        }) as EventListener);

        window.addEventListener("portfolio:reset", () => {
          container.dataset.reeditEnabled = "false";
          input.value = "";
          baseline = "";
          showCommitted();
        });

        showCommitted();
      }

      document.querySelectorAll<HTMLElement>("[data-reeditable='true']").forEach(initReeditablePill);
    </script>
  )
}
