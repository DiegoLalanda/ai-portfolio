---
import type { Translations } from "@/i18n/types";

interface Props {
  loading: Translations["loading"];
  /** Si es true, muestra estado "thinking" al montar (página demo). */
  demo?: boolean;
}

const { loading, demo = false } = Astro.props;
---

<div class="mx-auto w-full max-w-xl">
  <div
    id="loading-panel"
    class="loading-panel glass-panel relative overflow-hidden rounded-xl px-4 py-3 text-left fade-in-up delay-300 md:px-5 md:py-3.5"
    data-loading={JSON.stringify(loading)}
    data-demo={String(demo)}
  >
    <div class="mb-2 flex items-center gap-2.5">
      <div class="loading-panel__dot h-1.5 w-1.5 animate-pulse rounded-full bg-primary"></div>
      <span class="font-label-md text-label-md uppercase tracking-widest text-primary">{loading.label}</span>
    </div>

    <div class="loading-panel__row flex items-center gap-2.5">
      <span
        id="loading-status-icon"
        class="loading-message-icon material-symbols-outlined shrink-0 text-[18px] text-outline-variant"
        aria-hidden="true"
      >
        blur_on
      </span>
      <p id="loading-status-text" class="loading-panel__status shimmer-text truncate font-body-md text-body-md text-on-surface">
        {loading.status.thinking}
      </p>
    </div>

    <div id="loading-tools" class="loading-panel__tools mt-2 flex flex-wrap items-center gap-1.5 empty:hidden" aria-live="polite"></div>

    <div class="absolute bottom-0 left-0 h-[2px] w-full bg-white/5">
      <div id="global-progress" class="progress-line progress-line--indeterminate"></div>
    </div>
  </div>
</div>

<script>
  interface LoadingCopy {
    label: string;
    status: {
      thinking: string;
      synthesizing: string;
      done: string;
    };
    tools: Record<string, string>;
  }

  interface StreamEventDetail {
    type: string;
    phase?: string;
    tool?: string;
  }

  type ToolChipState = "running" | "done";

  const panel = document.getElementById("loading-panel");
  const statusText = document.getElementById("loading-status-text");
  const statusIcon = document.getElementById("loading-status-icon");
  const toolsContainer = document.getElementById("loading-tools");
  const progressLine = document.getElementById("global-progress");

  const copy: LoadingCopy = panel?.dataset.loading ? JSON.parse(panel.dataset.loading) : {
    label: "",
    status: { thinking: "Thinking…", synthesizing: "Building response…", done: "Done!" },
    tools: {},
  };

  /** Tools usadas en esta corrida — se mantienen a la vista (no se borran al terminar). */
  const usedTools = new Map<string, ToolChipState>();

  function toolLabel(name: string) {
    return copy.tools[name] ?? name.replace(/^get_/, "").replaceAll("_", " ");
  }

  function renderTools() {
    if (!toolsContainer) return;
    toolsContainer.innerHTML = "";

    usedTools.forEach((state, tool) => {
      const chip = document.createElement("span");
      chip.className = `loading-tool-chip loading-tool-chip--${state}`;

      if (state === "running") {
        const spinner = document.createElement("span");
        spinner.className = "loading-tool-chip__spinner";
        spinner.setAttribute("aria-hidden", "true");
        chip.appendChild(spinner);
      } else {
        const check = document.createElement("span");
        check.className = "loading-tool-chip__check";
        check.setAttribute("aria-hidden", "true");
        check.textContent = "✓";
        chip.appendChild(check);
      }

      const label = document.createElement("span");
      label.className = "loading-tool-chip__label";
      label.textContent = toolLabel(tool);
      chip.appendChild(label);

      toolsContainer.appendChild(chip);
    });
  }

  function setStatus(text: string, icon = "blur_on") {
    if (statusText) statusText.textContent = text;
    if (statusIcon) statusIcon.textContent = icon;
  }

  function resetPanel() {
    usedTools.clear();
    renderTools();
    setStatus(copy.status.thinking, "blur_on");
    progressLine?.classList.add("progress-line--indeterminate");
    progressLine?.classList.remove("progress-line--complete");
    if (progressLine) progressLine.style.width = "";
  }

  function handleStreamEvent(event: StreamEventDetail) {
    if (event.type === "started") {
      setStatus(copy.status.thinking, "blur_on");
      return;
    }

    if (event.type === "status") {
      if (event.phase === "synthesizing") {
        setStatus(copy.status.synthesizing, "auto_awesome");
      } else {
        setStatus(copy.status.thinking, "blur_on");
      }
      return;
    }

    if (event.type === "tool_call" && event.tool) {
      usedTools.set(event.tool, "running");
      setStatus(`${toolLabel(event.tool)}…`, "build");
      renderTools();
      return;
    }

    if (event.type === "tool_done" && event.tool) {
      usedTools.set(event.tool, "done");
      renderTools();
      if (![...usedTools.values()].some((state) => state === "running")) {
        setStatus(copy.status.thinking, "blur_on");
      }
    }
  }

  function completePanel() {
    usedTools.forEach((_, tool) => usedTools.set(tool, "done"));
    renderTools();
    setStatus(copy.status.done, "check_circle");
    progressLine?.classList.remove("progress-line--indeterminate");
    progressLine?.classList.add("progress-line--complete");
    if (progressLine) progressLine.style.width = "100%";
    window.dispatchEvent(new CustomEvent("loading:complete"));
  }

  window.addEventListener("loading:start", resetPanel);

  window.addEventListener("loading:stream", (event) => {
    const detail = (event as CustomEvent<StreamEventDetail>).detail;
    if (!detail) return;
    handleStreamEvent(detail);
  });

  window.addEventListener("loading:finish", completePanel);

  if (panel) resetPanel();
</script>
