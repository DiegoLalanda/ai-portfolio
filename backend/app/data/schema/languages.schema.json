{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://diegolalanda.dev/schema/languages.schema.json",
  "title": "Languages",
  "description": "Spoken languages and proficiency levels. Meant to be consumed by AI tools such as `get_languages`.",
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "id": { "$ref": "_common.schema.json#/$defs/id" },
      "name": { "type": "string" },
      "code": {
        "type": "string",
        "pattern": "^[a-z]{2}$",
        "description": "ISO 639-1 language code, e.g. \"en\"."
      },
      "proficiency": {
        "type": "string",
        "enum": ["A1", "A2", "B1", "B2", "C1", "C2", "native"],
        "description": "CEFR level, or \"native\"."
      },
      "proficiencyPercent": {
        "type": "integer",
        "minimum": 0,
        "maximum": 100,
        "description": "Self-rated proficiency as a percentage, for simple progress-bar UI."
      },
      "order": { "type": "integer", "description": "Manual sort order, ascending, within this file." },
      "visible": { "type": "boolean", "description": "Toggle to hide the entry without deleting it." }
    },
    "required": ["id", "name", "code", "proficiency", "proficiencyPercent", "order", "visible"],
    "additionalProperties": false
  }
}
