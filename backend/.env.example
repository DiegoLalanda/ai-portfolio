ENVIRONMENT=development

HOST=127.0.0.1
PORT=8000
RELOAD=true

BACKEND_CORS_ORIGINS=["http://localhost:4321","http://localhost:4322"]

GEMINI_API_KEY=

# langgraph es el default de develop. legacy conserva el loop anterior. main no cambia en esta fase.
GRAPH_ENGINE=langgraph

# Segundos por llamada. La de tools usa el router; la respuesta estructurada, el compositor.
LLM_TIMEOUT_ROUTER_S=12
LLM_TIMEOUT_COMPOSER_S=25

# gemini usa la misma GEMINI_API_KEY. hash es solo para tests, sin red.
EMBEDDING_PROVIDER=gemini
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
RAG_TOP_K=4

# LangGraph guarda el hilo en SQLite (no Redis: sin servicio extra, una réplica, costo cero).
# Un redeploy en Railway borra el archivo efímero del contenedor; Redis gestionado sería el paso si hubiera varias réplicas.
CHECKPOINT_PATH=data/checkpoints.sqlite

# Trazas — local: endpoint vacío → backend/evidencia/trazas.jsonl
# Railway: servicio Phoenix aparte (template Arize) y en ESTE servicio API:
#   PHOENIX_COLLECTOR_ENDPOINT=https://<phoenix>.up.railway.app/v1/traces
#   (también vale la base https://<phoenix>.up.railway.app; se agrega /v1/traces)
#   PHOENIX_PROJECT_NAME=ai-portfolio
# Si Phoenix tiene auth: PHOENIX_API_KEY=<key de Phoenix> en el API (no el PHOENIX_SECRET del servicio Phoenix).
# TRACE_JSONL=true solo si querés JSONL además de OTLP.
PROMPT_VERSION=2026-03-29
PHOENIX_COLLECTOR_ENDPOINT=
PHOENIX_API_KEY=
PHOENIX_PROJECT_NAME=ai-portfolio
TRACE_JSONL=false
