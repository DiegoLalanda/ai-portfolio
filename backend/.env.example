ENVIRONMENT=development

HOST=127.0.0.1
PORT=8000
RELOAD=true

BACKEND_CORS_ORIGINS=["http://localhost:4321","http://localhost:4322"]

GEMINI_API_KEY=

# legacy usa el loop actual. langgraph usa el grafo de un nodo. Producción sigue en legacy.
GRAPH_ENGINE=legacy

# Segundos por llamada. La de tools usa el router; la respuesta estructurada, el compositor.
LLM_TIMEOUT_ROUTER_S=12
LLM_TIMEOUT_COMPOSER_S=25
